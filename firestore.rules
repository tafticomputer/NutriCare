rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin()   { return signedIn() && userDoc().role == 'ADMIN'; }
    function isPatient() { return signedIn() && userDoc().role == 'PATIENT'; }

    // کاربران: ثبت‌نام فقط با نقش PATIENT؛ تغییر نقش فقط توسط مدیر
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'PATIENT';
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.active == resource.data.active;
      allow write: if isAdmin();
    }

    // پزشکان: بیماران فقط پزشکان تأییدشده را می‌بینند؛ نوشتن فقط مدیر
    match /doctors/{uid} {
      allow read: if signedIn()
                  && (resource.data.approved == true
                      || request.auth.uid == uid
                      || isAdmin());
      allow write: if isAdmin();
    }

    // درخواست‌ها (کارتابل)
    match /requests/{rid} {
      allow read: if signedIn()
                  && (resource.data.patientId == request.auth.uid
                      || resource.data.doctorId == request.auth.uid
                      || isAdmin());

      allow create: if isPatient()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && get(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)).data.approved == true;

      allow update: if signedIn()
                    && resource.data.doctorId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'rejectReason', 'updatedAt'])
                    && (
                         (resource.data.status == 'PENDING'
                           && request.resource.data.status in ['ACCEPTED', 'REJECTED'])
                      || (resource.data.status == 'ACCEPTED'
                           && request.resource.data.status == 'COMPLETED')
                       );

      match /messages/{mid} {
        function req() {
          return get(/databases/$(database)/documents/requests/$(rid)).data;
        }
        function isParticipant() {
          return signedIn()
                 && (req().patientId == request.auth.uid
                     || req().doctorId == request.auth.uid);
        }
        allow read: if isParticipant();
        allow create: if isParticipant()
                      && req().status == 'ACCEPTED'
                      && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
